# App runtime
PORT=3000
NODE_ENV=development
PUBLIC_APP_ORIGIN=http://localhost:3000
AUTH_PROVIDER=manus

# Database
DATABASE_URL=mysql://user:password@localhost:3306/mamo_finance
JWT_SECRET=replace-with-a-long-random-secret

# OAuth / auth provider
VITE_APP_ID=your-oauth-app-id
OAUTH_SERVER_URL=https://your-oauth-provider.example
VITE_OAUTH_PORTAL_URL=https://your-oauth-provider.example/app-auth
OAUTH_PORTAL_URL=https://your-oauth-provider.example/app-auth
OWNER_OPEN_ID=your-owner-openid

# Supabase migration helper values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Expo/mobile
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ID=your-oauth-app-id
EXPO_PUBLIC_OAUTH_PORTAL_URL=http://localhost:3000/api/auth/login
